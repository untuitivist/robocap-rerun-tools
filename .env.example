# Copy this file to .env and keep the real token local.
MODELSCOPE_API_TOKEN=
MODELSCOPE_ENDPOINT=https://modelscope.cn
MODELSCOPE_REPO_ID=
MODELSCOPE_ERROR_REPO_ID=untuitivist/EgoMotionActions-fault
# Choose one capture room per upload: site_01 (white-wall), site_02 (green-screen).
# Leave empty to retain existing site metadata without guessing a site for new sessions.
ROBOCAP_COLLECTION_SITE=
# QQ SMTP summary email after batch uploads. Keep authorization codes local.
UPLOAD_EMAIL_SENDER=
UPLOAD_EMAIL_AUTH_CODE=
UPLOAD_EMAIL_RECEIVER=
